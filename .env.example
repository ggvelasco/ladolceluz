# Senha da página /admin (lista de embarque do RH). Sem ela, o painel fica desativado.
ADMIN_KEY=troque-por-uma-senha-forte

# Porta do servidor em produção (npm start)
PORT=3000

# Pasta onde o arquivo de reservas é gravado (padrão: ./data).
# No Railway não precisa: o caminho do volume é detectado sozinho.
# DATA_DIR=./data

# Defina como 1 se o site ficar atrás de um proxy reverso (Nginx, Render...).
# No Railway já é automático.
# TRUST_PROXY=1
